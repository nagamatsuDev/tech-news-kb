new file mode 100644
index 0000000..2eb28fb
--- /dev/null
+++ b/src/shared/version.ts
@@ -0,0 +1,60 @@
+/**
+ * バージョン比較と GHSA 形式の範囲判定（ブラウザ / Node 共通）
+ *   範囲の例: "< 1.2.3" / ">= 4.0.0, < 4.5.2" / "= 1.0.0" / "<= 2.1"
+ * semver に限らず、数字とプレリリースを含む一般的な表記を扱う
+ */
+
+type Part = number | string;
+
+function parts(v: string): { main: Part[]; pre: Part[] } {
+  const clean = v.trim().replace(/^v/i, "").split("+")[0];
+  const [mainStr, ...preRest] = clean.split("-");
+  const split = (s: string) => s.split(/[._]/).filter(Boolean).map((x) => (/^\d+$/.test(x) ? Number(x) : x));
+  return { main: split(mainStr), pre: preRest.length ? split(preRest.join("-")) : [] };
+}
+
+function cmpParts(a: Part[], b: Part[], padNumeric: boolean): number {
+  const n = Math.max(a.length, b.length);
+  for (let i = 0; i < n; i++) {
+    const x = a[i] ?? (padNumeric ? 0 : undefined);
+    const y = b[i] ?? (padNumeric ? 0 : undefined);
+    if (x === undefined) return -1;
+    if (y === undefined) return 1;
+    if (x === y) continue;
+    if (typeof x === "number" && typeof y === "number") return x < y ? -1 : 1;
+    if (typeof x === "number") return -1;
+    if (typeof y === "number") return 1;
+    return x < y ? -1 : 1;
+  }
+  return 0;
+}
+
+/** a < b なら負、a > b なら正 */
+export function compareVersions(a: string, b: string): number {
+  const pa = parts(a);
+  const pb = parts(b);
+  const c = cmpParts(pa.main, pb.main, true);
+  if (c !== 0) return c;
+  // プレリリースは正式版より小さい
+  if (pa.pre.length === 0 && pb.pre.length === 0) return 0;
+  if (pa.pre.length === 0) return 1;
+  if (pb.pre.length === 0) return -1;
+  return cmpParts(pa.pre, pb.pre, false);
+}
+
+/** GHSA の vulnerable_version_range に version が含まれるか。解釈できなければ undefined */
+export function inRange(version: string, range: string | undefined): boolean | undefined {
+  if (!range) return undefined;
+  const conds = range.split(",").map((s) => s.trim()).filter(Boolean);
+  if (!conds.length) return undefined;
+  for (const c of conds) {
+    const m = c.match(/^(<=|>=|<|>|=|==)?\s*([0-9A-Za-z][0-9A-Za-z._+\-]*)$/);
+    if (!m) return undefined;
+    const op = m[1] ?? "=";
+    const r = compareVersions(version, m[2]);
+    const ok =
+      op === "<" ? r < 0 : op === "<=" ? r <= 0 : op === ">" ? r > 0 : op === ">=" ? r >= 0 : r === 0;
+    if (!ok) return false;
+  }
+  return true;
+}
diff --git a/src/shared/week.ts b/src/shared/week.ts
new file mode 100644
index 0000000..fb1e617
--- /dev/null
+++ b/src/shared/week.ts
@@ -0,0 +1,61 @@
+/**
+ * ISO 週（月曜始まり）を日本時間で扱う
+ * 例: 2026-11-16（月）〜 2026-11-22（日）= "2026-W47"
+ */
+
+const JST_OFFSET = 9 * 3600_000;
+const DAY = 86_400_000;
+
+export const WEEK_RE = /^(\d{4})-W(\d{2})$/;
+
+/** 日時 → JST の ISO 週 */
+export function isoWeekOf(date: Date | string | number): string {
+  const t = new Date(date).getTime() + JST_OFFSET;
+  const d = new Date(t);
+  // UTC メソッドで JST の暦日を扱う
+  const day = (d.getUTCDay() + 6) % 7; // 月=0 … 日=6
+  const thursday = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - day + 3));
+  const year = thursday.getUTCFullYear();
+  const jan4 = new Date(Date.UTC(year, 0, 4));
+  const jan4Day = (jan4.getUTCDay() + 6) % 7;
+  const week1Monday = jan4.getTime() - jan4Day * DAY;
+  const week = Math.floor((thursday.getTime() - 3 * DAY - week1Monday) / (7 * DAY)) + 1;
+  return `${year}-W${String(week).padStart(2, "0")}`;
+}
+
+/** ISO 週の月曜 0:00 JST（UTC の Date） */
+export function weekStart(week: string): Date {
+  const m = week.match(WEEK_RE);
+  if (!m) throw new Error(`invalid week: ${week}`);
+  const year = Number(m[1]);
+  const w = Number(m[2]);
+  const jan4 = Date.UTC(year, 0, 4);
+  const jan4Day = (new Date(jan4).getUTCDay() + 6) % 7;
+  const monday = jan4 - jan4Day * DAY + (w - 1) * 7 * DAY;
+  return new Date(monday - JST_OFFSET);
+}
+
+export function addWeeks(week: string, n: number): string {
+  return isoWeekOf(weekStart(week).getTime() + n * 7 * DAY + DAY);
+}
+
+/** 表示用 "11/16–11/22" */
+export function weekRangeLabel(week: string): string {
+  const start = weekStart(week).getTime() + JST_OFFSET;
+  const fmt = (t: number) => {
+    const d = new Date(t);
+    return `${d.getUTCMonth() + 1}/${d.getUTCDate()}`;
+  };
+  return `${fmt(start)}–${fmt(start + 6 * DAY)}`;
+}
+
+/** from 〜 to（両端含む）の週一覧 */
+export function weeksBetween(from: string, to: string): string[] {
+  const out: string[] = [];
+  let w = from;
+  for (let i = 0; i < 1000 && w <= to; i++) {
+    out.push(w);
+    w = addWeeks(w, 1);
+  }
+  return out;
+}
diff --git a/src/translate/machine.ts b/src/translate/machine.ts
new file mode 100644
index 0000000..67b1df1
--- /dev/null
+++ b/src/translate/machine.ts
@@ -0,0 +1,73 @@
+/**
+ * 機械翻訳（費用 0・外部送信なし）
+ *   FuguMT（英→日の翻訳専用モデル）を Transformers.js で GitHub Actions 上で動かす。
+ *   指示に従う LLM ではないので、説明文に「指示を無視して…」と書かれていてもそのまま訳されるだけ。
+ *   それでも出力は信用せず isSafeTranslation で検証する。
+ *
+ *   @huggingface/transformers は optionalDependencies。入っていない・モデルが読めない場合は
+ *   翻訳をスキップして英語のまま保存する（収集は止めない）。
+ *
+ *   ENV: TRANSLATE=off で無効化、TRANSLATE_MAX（既定 150）で 1 回の上限件数
+ */
+
+import { cleanText, isSafeTranslation } from "../shared/sanitize.js";
+
+const MODEL = process.env.TRANSLATE_MODEL ?? "Kadonox/fugumt-en-ja-onnx";
+
+type Translator = (texts: string[]) => Promise<{ translation_text: string }[]>;
+let translator: Translator | null | undefined;
+
+async function load(): Promise<Translator | null> {
+  if (translator !== undefined) return translator;
+  if (process.env.TRANSLATE === "off") return (translator = null);
+  try {
+    // 型定義に依存しないよう動的 import（未インストールでもビルドが通る）
+    const mod: any = await import(/* @vite-ignore */ "@huggingface/transformers" as string);
+    if (process.env.HF_CACHE_DIR) mod.env.cacheDir = process.env.HF_CACHE_DIR;
+    const pipe = await mod.pipeline("translation", MODEL, { dtype: "q8" });
+    translator = (texts: string[]) => pipe(texts, { max_new_tokens: 512 });
+    console.log(`  [Translate] loaded ${MODEL}`);
+  } catch (err) {
+    console.warn(`  [Translate] disabled: ${err instanceof Error ? err.message : err}`);
+    translator = null;
+  }
+  return translator;
+}
+
+/** 文に分割（FuguMT は文単位で訳す方が品質が良い） */
+export function splitSentences(text: string): string[] {
+  return text
+    .replace(/\s+/g, " ")
+    .split(/(?<=[.!?])\s+(?=[A-Z0-9"(])/)
+    .map((s) => s.trim())
+    .filter(Boolean);
+}
+
+/** 先頭の数文だけを訳す（全文は原文リンクで読める） */
+export function excerpt(text: string, maxSentences = 3, maxChars = 600): string {
+  const out: string[] = [];
+  let len = 0;
+  for (const s of splitSentences(text)) {
+    if (out.length >= maxSentences || len + s.length > maxChars) break;
+    out.push(s);
+    len += s.length;
+  }
+  return out.join(" ") || text.slice(0, maxChars);
+}
+
+/** 1 件を訳す。失敗・不正な出力なら undefined */
+export async function translate(text: string): Promise<string | undefined> {
+  const t = await load();
+  if (!t || !text.trim()) return undefined;
+  try {
+    const sentences = splitSentences(text);
+    const res = await t(sentences);
+    const ja = cleanText(res.map((r) => r.translation_text).join(""), 2000);
+    return isSafeTranslation(text, ja) ? ja : undefined;
+  } catch (err) {
+    console.warn(`  [Translate] ${err instanceof Error ? err.message : err}`);
+    return undefined;
+  }
+}
+
+export const TRANSLATE_MAX = Number(process.env.TRANSLATE_MAX ?? 150);
