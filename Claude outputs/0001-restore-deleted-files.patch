+++ b/site/src/lib/client/manifest-type.ts
@@ -0,0 +1,19 @@
+/** 依存ファイル名から形式を判定する（DOM 非依存） */
+
+/** 「package-lock (1).json」のような名前も種類を判定する */
+export function manifestType(fileName: string): string | undefined {
+  const n = fileName.toLowerCase();
+  const table: [RegExp, string][] = [
+    [/package-lock.*\.json$/, "package-lock.json"],
+    [/pnpm-lock.*\.ya?ml$/, "pnpm-lock.yaml"],
+    [/yarn.*\.lock$/, "yarn.lock"],
+    [/package.*\.json$/, "package.json"],
+    [/poetry.*\.lock$/, "poetry.lock"],
+    [/requirements.*\.txt$/, "requirements.txt"],
+    [/go.*\.mod$/, "go.mod"],
+    [/cargo.*\.lock$/, "Cargo.lock"],
+    [/gemfile.*\.lock$/, "Gemfile.lock"],
+    [/composer.*\.lock$/, "composer.lock"],
+  ];
+  return table.find(([re]) => re.test(n))?.[1];
+}
diff --git a/site/src/lib/client/match.ts b/site/src/lib/client/match.ts
new file mode 100644
index 0000000..6945483
--- /dev/null
+++ b/site/src/lib/client/match.ts
@@ -0,0 +1,84 @@
+/**
+ * 設定・依存パッケージとの照合（ブラウザ内。通信しない）
+ *
+ *   3: 依存パッケージに該当（パッケージ名一致 かつ バージョンが影響範囲内）
+ *   2: 製品名 または 言語が一致
+ *   1: OS が一致
+ *   0: 一致なし
+ */
+
+import type { AffectedPackage, Dependency } from "../../../../src/types/vuln.js";
+import { inRange } from "../../../../src/shared/version.js";
+import type { Settings } from "./storage.js";
+
+export interface MatchInput {
+  os: string[];
+  languages: string[];
+  products: string[];
+  title: string;
+  packages: AffectedPackage[];
+}
+
+export interface MatchResult {
+  level: 0 | 1 | 2 | 3;
+  /** 表示用の理由 */
+  reasons: string[];
+  /** 該当した依存（level 3 のとき） */
+  deps: { name: string; version: string; fixed?: string; approximate: boolean; dev: boolean }[];
+}
+
+const norm = (s: string) => s.toLowerCase().trim();
+
+/** エコシステム名の表記ゆれ（GHSA と OSV） */
+const ECO_ALIASES: Record<string, string> = { pip: "pypi", rust: "crates.io", composer: "packagist", rubygems: "rubygems" };
+const eco = (e: string) => ECO_ALIASES[norm(e)] ?? norm(e);
+
+/** パッケージ名の比較（PyPI は _ - . を同一視） */
+function samePackage(a: string, b: string, ecosystem: string): boolean {
+  if (eco(ecosystem) === "pypi") return norm(a).replace(/[-_.]+/g, "-") === norm(b).replace(/[-_.]+/g, "-");
+  return norm(a) === norm(b);
+}
+
+export function indexDeps(deps: Dependency[]): Map<string, Dependency[]> {
+  const m = new Map<string, Dependency[]>();
+  for (const d of deps) {
+    const key = `${eco(d.ecosystem)}|${eco(d.ecosystem) === "pypi" ? norm(d.name).replace(/[-_.]+/g, "-") : norm(d.name)}`;
+    m.set(key, [...(m.get(key) ?? []), d]);
+  }
+  return m;
+}
+
+export function matchVuln(v: MatchInput, settings: Settings, depIndex: Map<string, Dependency[]>): MatchResult {
+  const reasons: string[] = [];
+  const hitDeps: MatchResult["deps"] = [];
+
+  for (const p of v.packages) {
+    const key = `${eco(p.ecosystem)}|${eco(p.ecosystem) === "pypi" ? norm(p.name).replace(/[-_.]+/g, "-") : norm(p.name)}`;
+    for (const d of depIndex.get(key) ?? []) {
+      if (!samePackage(d.name, p.name, p.ecosystem)) continue;
+      const hit = inRange(d.version, p.vulnerableRange);
+      // 範囲が読めない場合は安全側（該当扱い）にせず、名前一致として level 2 にとどめる
+      if (hit === true) hitDeps.push({ name: d.name, version: d.version, fixed: p.fixedVersion, approximate: d.approximate, dev: d.dev });
+      else if (hit === undefined) reasons.push(`パッケージ名が一致: ${d.name}（範囲は要確認）`);
+    }
+  }
+  if (hitDeps.length) {
+    return { level: 3, reasons: [`依存に該当: ${[...new Set(hitDeps.map((d) => `${d.name}@${d.version}`))].join(", ")}`], deps: hitDeps };
+  }
+
+  const text = `${v.title} ${v.products.join(" ")}`.toLowerCase();
+  const productHit = settings.products.find((w) => {
+    const word = norm(w);
+    if (word.length < 2) return false;
+    const re = new RegExp(`(^|[^a-z0-9])${word.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}([^a-z0-9]|$)`);
+    return re.test(text);
+  });
+  if (productHit) reasons.push(`製品が一致: ${productHit}`);
+  const langHit = v.languages.filter((l) => settings.languages.includes(l));
+  if (langHit.length) reasons.push(`言語が一致: ${langHit.join(", ")}`);
+  if (reasons.length) return { level: 2, reasons, deps: [] };
+
+  const osHit = v.os.filter((o) => settings.os.includes(o));
+  if (osHit.length) return { level: 1, reasons: [`OS が一致: ${osHit.join(", ")}`], deps: [] };
+  return { level: 0, reasons: [], deps: [] };
+}
diff --git a/site/src/lib/client/osv.ts b/site/src/lib/client/osv.ts
new file mode 100644
index 0000000..c7efe2e
--- /dev/null
+++ b/site/src/lib/client/osv.ts
@@ -0,0 +1,156 @@
+/**
+ * ブラウザから OSV.dev に依存一覧を問い合わせる（過去の未対応タブ用）
+ * 送るのはパッケージ名・バージョン・エコシステムだけ。結果は 1 日キャッシュする。
+ */
+
+import type { Dependency, Severity } from "../../../../src/types/vuln.js";
+import { cvss3BaseScore, normalizeSeverity, severityFromScore } from "../../../../src/processors/classify.js";
+import { ID_PATTERNS, cleanText, detailUrl, isValidVulnId, safeUrl } from "../../../../src/shared/sanitize.js";
+import { uuidV5 } from "../../../../src/shared/uuid.js";
+import { loadOsvCache, saveOsvCache } from "./storage.js";
+
+const OSV = "https://api.osv.dev/v1";
+
+export interface PastItem {
+  uuid: string;
+  /** 正式 UUID がなく v5 で作ったか */
+  provisional: boolean;
+  ids: string[];
+  title: string;
+  severity: Severity;
+  cvssScore?: number;
+  published?: string;
+  /** 該当した依存 */
+  deps: { name: string; version: string; ecosystem: string; fixed?: string; dev: boolean; approximate: boolean }[];
+  links: { url: string; host: string; label: string }[];
+}
+
+interface OsvVuln {
+  id: string;
+  aliases?: string[];
+  summary?: string;
+  details?: string;
+  published?: string;
+  withdrawn?: string;
+  severity?: { type: string; score: string }[];
+  database_specific?: { severity?: string };
+  affected?: { package?: { ecosystem: string; name: string }; ranges?: { events: Record<string, string>[] }[] }[];
+  references?: { type: string; url: string }[];
+}
+
+async function postJson<T>(url: string, body: unknown): Promise<T> {
+  const res = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+  if (!res.ok) throw new Error(`OSV HTTP ${res.status}`);
+  return res.json() as Promise<T>;
+}
+async function getJson<T>(url: string): Promise<T> {
+  const res = await fetch(url);
+  if (!res.ok) throw new Error(`OSV HTTP ${res.status}`);
+  return res.json() as Promise<T>;
+}
+
+function severityOf(v: OsvVuln): { severity: Severity; score?: number } {
+  const vector = v.severity?.find((s) => s.type === "CVSS_V3")?.score;
+  const score = vector ? cvss3BaseScore(vector) : undefined;
+  const db = normalizeSeverity(v.database_specific?.severity);
+  return { severity: db !== "unknown" ? db : severityFromScore(score), score };
+}
+
+function fixedFor(v: OsvVuln, dep: Dependency): string | undefined {
+  const fixes: string[] = [];
+  for (const a of v.affected ?? []) {
+    if (a.package?.name !== dep.name || a.package?.ecosystem !== dep.ecosystem) continue;
+    for (const r of a.ranges ?? []) for (const e of r.events) if (e.fixed) fixes.push(e.fixed);
+  }
+  return fixes.sort((a, b) => a.localeCompare(b, undefined, { numeric: true })).find((f) => f.localeCompare(dep.version, undefined, { numeric: true }) > 0) ?? fixes[0];
+}
+
+/** OSV の参照のうち表示するもの（攻撃コード = EVIDENCE は除外） */
+function osvLinks(v: OsvVuln, ids: string[]): PastItem["links"] {
+  const out: PastItem["links"] = [];
+  for (const id of ids) {
+    const u = detailUrl(id);
+    if (u && out.length < 3) out.push({ url: u.href, host: u.host, label: id });
+  }
+  for (const r of v.references ?? []) {
+    if (!["ADVISORY", "FIX", "WEB", "ARTICLE"].includes(r.type)) continue;
+    const u = safeUrl(r.url);
+    if (u && !out.some((l) => l.url === u.href) && out.length < 6) out.push({ url: u.href, host: u.host, label: r.type === "ADVISORY" ? `公式発表 (${u.host})` : u.host });
+  }
+  return out;
+}
+
+/** 依存一覧のキー（内容が変わればキャッシュを使わない） */
+export function depsKey(deps: Dependency[]): string {
+  return uuidV5(deps.map((d) => `${d.ecosystem}|${d.name}|${d.version}`).sort().join("\n"));
+}
+
+/**
+ * @param idToUuid ids.json の ids（収集データにある脆弱性は正式 UUID を使う）
+ */
+export async function queryPast(deps: Dependency[], idToUuid: Record<string, string>, force = false): Promise<PastItem[]> {
+  const key = depsKey(deps);
+  if (!force) {
+    const cached = loadOsvCache<PastItem>(key);
+    if (cached) return cached;
+  }
+  if (deps.length === 0) return [];
+
+  const idsPerDep: string[][] = [];
+  for (let i = 0; i < deps.length; i += 1000) {
+    const batch = deps.slice(i, i + 1000);
+    const data = await postJson<{ results: { vulns?: { id: string }[] }[] }>(`${OSV}/querybatch`, {
+      queries: batch.map((d) => ({ package: { name: d.name, ecosystem: d.ecosystem }, version: d.version })),
+    });
+    for (const r of data.results) idsPerDep.push((r.vulns ?? []).map((v) => v.id).filter(isValidVulnId));
+  }
+
+  const unique = [...new Set(idsPerDep.flat())].slice(0, 500);
+  const details = new Map<string, OsvVuln>();
+  let next = 0;
+  await Promise.all(
+    Array.from({ length: Math.min(6, unique.length) }, async () => {
+      while (next < unique.length) {
+        const id = unique[next++];
+        try {
+          const v = await getJson<OsvVuln>(`${OSV}/vulns/${encodeURIComponent(id)}`);
+          if (!v.withdrawn) details.set(id, v);
+        } catch {}
+      }
+    }),
+  );
+
+  // 同じ脆弱性（GHSA と PYSEC など別 ID）をまとめる
+  const byUuid = new Map<string, PastItem>();
+  deps.forEach((dep, i) => {
+    for (const id of idsPerDep[i] ?? []) {
+      const v = details.get(id);
+      if (!v) continue;
+      const ids = [...new Set([v.id, ...(v.aliases ?? [])])].filter(isValidVulnId);
+      ids.sort((a, b) => (a.startsWith("CVE-") ? -1 : b.startsWith("CVE-") ? 1 : 0));
+      const real = ids.map((x) => idToUuid[x]).find((u) => u && ID_PATTERNS.uuid.test(u));
+      const uuid = real ?? uuidV5(ids[0]);
+      const { severity, score } = severityOf(v);
+      const item =
+        byUuid.get(uuid) ??
+        ({
+          uuid,
+          provisional: !real,
+          ids,
+          title: cleanText(v.summary || v.details?.split("\n")[0] || ids[0], 300),
+          severity,
+          cvssScore: score,
+          published: v.published,
+          deps: [],
+          links: osvLinks(v, ids),
+        } satisfies PastItem);
+      if (!item.deps.some((d) => d.name === dep.name && d.version === dep.version)) {
+        item.deps.push({ name: dep.name, version: dep.version, ecosystem: dep.ecosystem, fixed: fixedFor(v, dep), dev: dep.dev, approximate: dep.approximate });
+      }
+      byUuid.set(uuid, item);
+    }
+  });
+  const items = [...byUuid.values()];
+  saveOsvCache(key, items);
+  return items;
+}
diff --git a/site/src/lib/client/settings-ui.ts b/site/src/lib/client/settings-ui.ts
new file mode 100644
index 0000000..91f6fe9
--- /dev/null
+++ b/site/src/lib/client/settings-ui.ts
@@ -0,0 +1,142 @@
+/**
+ * 設定ダイアログ（右上の ⚙️）
+ * 保存すると "vulnkb:changed" イベントを出し、ボードが再照合する
+ */
+
+import { parseManifest } from "../../../../src/projects/manifests.js";
+import type { Dependency } from "../../../../src/types/vuln.js";
+import { manifestType } from "./manifest-type.js";
+import { exportAll, importAll, loadDeps, loadSettings, saveDeps, saveSettings, type DepsStore } from "./storage.js";
+
+const MAX_FILE_BYTES = 10 * 1024 * 1024;
+
+const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
+
+function renderDepsSummary(store: DepsStore) {
+  const el = $("deps-summary");
+  if (!el) return;
+  if (store.files.length === 0) {
+    el.textContent = "まだ読み込んでいません";
+    return;
+  }
+  const approx = store.deps.filter((d) => d.approximate).length;
+  el.textContent =
+    `${store.files.map((f) => `${f.name}（${f.count} 件）`).join("、")} — 合計 ${store.deps.length} パッケージ` +
+    (approx ? `（うち ${approx} 件は package.json の範囲から推定。正確に照合するにはロックファイルを読み込んでください）` : "");
+}
+
+function fill() {
+  const s = loadSettings();
+  document.querySelectorAll<HTMLInputElement>('#settings input[name="os"]').forEach((i) => (i.checked = s.os.includes(i.value)));
+  document.querySelectorAll<HTMLInputElement>('#settings input[name="lang"]').forEach((i) => (i.checked = s.languages.includes(i.value)));
+  const products = $<HTMLTextAreaElement>("products");
+  if (products) products.value = s.products.join("\n");
+  renderDepsSummary(loadDeps());
+  $("deps-error")?.classList.add("hidden");
+  const io = $("io-message");
+  if (io) io.textContent = "";
+}
+
+/** 読み込み中の依存（保存ボタンで確定） */
+let pendingDeps: DepsStore | undefined;
+
+async function onFiles(files: FileList) {
+  const err = $("deps-error");
+  const errors: string[] = [];
+  const store: DepsStore = pendingDeps ?? loadDeps();
+  for (const file of Array.from(files)) {
+    const type = manifestType(file.name);
+    if (!type) {
+      errors.push(`${file.name}: 対応していない形式です`);
+      continue;
+    }
+    if (file.size > MAX_FILE_BYTES) {
+      errors.push(`${file.name}: 10MB を超えています`);
+      continue;
+    }
+    try {
+      const deps: Dependency[] = parseManifest(type, await file.text()).map((d) => ({ ...d, manifest: file.name }));
+      // 同じ名前のファイルは置き換え
+      store.deps = [...store.deps.filter((d) => d.manifest !== file.name), ...deps];
+      store.files = [...store.files.filter((f) => f.name !== file.name), { name: file.name, count: deps.length, loadedAt: new Date().toISOString() }];
+    } catch (e) {
+      errors.push(`${file.name}: 読み込めませんでした（${e instanceof Error ? e.message : e}）`);
+    }
+  }
+  pendingDeps = store;
+  renderDepsSummary(store);
+  if (err) {
+    err.textContent = errors.join(" / ");
+    err.classList.toggle("hidden", errors.length === 0);
+  }
+}
+
+function save() {
+  const os = [...document.querySelectorAll<HTMLInputElement>('#settings input[name="os"]:checked')].map((i) => i.value);
+  const languages = [...document.querySelectorAll<HTMLInputElement>('#settings input[name="lang"]:checked')].map((i) => i.value);
+  const products = ($<HTMLTextAreaElement>("products")?.value ?? "")
+    .split(/[\n,]/)
+    .map((s) => s.trim())
+    .filter(Boolean);
+  saveSettings({ os, languages, products });
+  if (pendingDeps) saveDeps(pendingDeps);
+  pendingDeps = undefined;
+  window.dispatchEvent(new CustomEvent("vulnkb:changed"));
+}
+
+function download(name: string, text: string) {
+  const url = URL.createObjectURL(new Blob([text], { type: "application/json" }));
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = name;
+  a.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+function init() {
+  const dialog = $<HTMLDialogElement>("settings");
+  if (!dialog) return;
+  $("settings-open")?.addEventListener("click", () => {
+    pendingDeps = undefined;
+    fill();
+    dialog.showModal();
+  });
+  const close = () => {
+    pendingDeps = undefined;
+    dialog.close();
+  };
+  $("settings-close")?.addEventListener("click", close);
+  $("settings-cancel")?.addEventListener("click", close);
+  $("settings-save")?.addEventListener("click", () => {
+    save();
+    dialog.close();
+  });
+  $<HTMLInputElement>("deps-file")?.addEventListener("change", (e) => {
+    const input = e.target as HTMLInputElement;
+    if (input.files?.length) void onFiles(input.files).then(() => (input.value = ""));
+  });
+  $("deps-clear")?.addEventListener("click", () => {
+    pendingDeps = { files: [], deps: [] };
+    renderDepsSummary(pendingDeps);
+  });
+  $("export")?.addEventListener("click", () => download(`vulnkb-${new Date().toISOString().slice(0, 10)}.json`, exportAll()));
+  $<HTMLInputElement>("import")?.addEventListener("change", async (e) => {
+    const input = e.target as HTMLInputElement;
+    const file = input.files?.[0];
+    const io = $("io-message");
+    if (!file) return;
+    try {
+      if (file.size > MAX_FILE_BYTES) throw new Error("ファイルが大きすぎます");
+      const { statuses } = importAll(await file.text());
+      fill();
+      if (io) io.textContent = `読み込みました（ステータス ${statuses} 件）`;
+      window.dispatchEvent(new CustomEvent("vulnkb:changed"));
+    } catch (err) {
+      if (io) io.textContent = `読み込めませんでした: ${err instanceof Error ? err.message : err}`;
+    } finally {
+      input.value = "";
+    }
+  });
+}
+
+init();
diff --git a/site/src/lib/client/storage.ts b/site/src/lib/client/storage.ts
new file mode 100644
index 0000000..f34d5d6
--- /dev/null
+++ b/site/src/lib/client/storage.ts
@@ -0,0 +1,255 @@
+/**
+ * localStorage（ブラウザ内だけに保存。どこにも送らない）
+ *
+ *   vulnkb:v1:status    { [uuid]: { status, updatedAt, ids? } }   記録なし = 未対応
+ *   vulnkb:v1:settings  { os[], languages[], products[] }
+ *   vulnkb:v1:deps      { files[], deps[] }                      読み込んだ依存ファイルの解析結果
+ *   vulnkb:v1:depHits   { [uuid]: firstMatchedAt }               一度でも依存に該当したもの
+ *   vulnkb:v1:osvCache  { at, key, items[] }                     OSV の照合結果（1 日キャッシュ）
+ *
+ * 同じドメイン（*.github.io）の他のページからも読み書きできるため、
+ * 読み込み時に必ず形式を検証し、壊れていても動くようにする。
+ */
+
+import type { Dependency } from "../../../../src/types/vuln.js";
+import { ID_PATTERNS, isValidVulnId } from "../../../../src/shared/sanitize.js";
+
+export type Status = "todo" | "doing" | "done";
+export const STATUSES: Status[] = ["todo", "doing", "done"];
+export const STATUS_LABEL: Record<Status, string> = { todo: "未対応", doing: "対応中", done: "対応完了" };
+
+export interface StatusRecord {
+  status: Status;
+  updatedAt: string;
+  /** v5 で作った UUID のみ: 正式な UUID へ付け替えるための別名 */
+  ids?: string[];
+}
+
+export interface Settings {
+  os: string[];
+  languages: string[];
+  products: string[];
+}
+
+export interface DepsStore {
+  files: { name: string; count: number; loadedAt: string }[];
+  deps: Dependency[];
+}
+
+const KEY = {
+  status: "vulnkb:v1:status",
+  settings: "vulnkb:v1:settings",
+  deps: "vulnkb:v1:deps",
+  depHits: "vulnkb:v1:depHits",
+  osvCache: "vulnkb:v1:osvCache",
+} as const;
+
+/** テスト用に差し替えられるストレージ */
+let store: Pick<Storage, "getItem" | "setItem" | "removeItem"> | undefined;
+export function useStorage(s: Pick<Storage, "getItem" | "setItem" | "removeItem">) {
+  store = s;
+}
+function backend() {
+  if (store) return store;
+  try {
+    return globalThis.localStorage;
+  } catch {
+    return undefined; // プライベートモード等
+  }
+}
+
+function read(key: string): unknown {
+  try {
+    const raw = backend()?.getItem(key);
+    return raw ? JSON.parse(raw) : undefined;
+  } catch {
+    return undefined;
+  }
+}
+function write(key: string, value: unknown) {
+  try {
+    backend()?.setItem(key, JSON.stringify(value));
+  } catch (err) {
+    console.warn("[vulnkb] localStorage に保存できません", err);
+  }
+}
+
+const isObj = (x: unknown): x is Record<string, unknown> => typeof x === "object" && x !== null && !Array.isArray(x);
+const strList = (x: unknown, max = 200, maxLen = 100): string[] =>
+  Array.isArray(x) ? x.filter((s): s is string => typeof s === "string" && s.length > 0 && s.length <= maxLen).slice(0, max) : [];
+const isIso = (s: unknown): s is string => typeof s === "string" && !Number.isNaN(Date.parse(s));
+
+// ---------------- status ----------------
+
+export function validateStatusMap(raw: unknown): Record<string, StatusRecord> {
+  const out: Record<string, StatusRecord> = {};
+  if (!isObj(raw)) return out;
+  for (const [uuid, rec] of Object.entries(raw)) {
+    if (!ID_PATTERNS.uuid.test(uuid) || !isObj(rec)) continue;
+    if (!STATUSES.includes(rec.status as Status)) continue;
+    const r: StatusRecord = { status: rec.status as Status, updatedAt: isIso(rec.updatedAt) ? rec.updatedAt : new Date(0).toISOString() };
+    const ids = strList(rec.ids, 20, 40).filter(isValidVulnId);
+    if (ids.length) r.ids = ids;
+    out[uuid] = r;
+  }
+  return out;
+}
+
+export const loadStatuses = () => validateStatusMap(read(KEY.status));
+
+export function getStatus(uuid: string): Status {
+  return loadStatuses()[uuid]?.status ?? "todo";
+}
+
+export function setStatus(uuid: string, status: Status, ids?: string[]) {
+  if (!ID_PATTERNS.uuid.test(uuid) || !STATUSES.includes(status)) return;
+  const map = loadStatuses();
+  const rec: StatusRecord = { status, updatedAt: new Date().toISOString() };
+  const keepIds = ids?.filter(isValidVulnId) ?? map[uuid]?.ids;
+  if (keepIds?.length) rec.ids = keepIds;
+  map[uuid] = rec;
+  write(KEY.status, map);
+  if (status === "done") {
+    const hits = loadDepHits();
+    delete hits[uuid];
+    write(KEY.depHits, hits);
+  }
+}
+
+/**
+ * v5（仮）UUID のステータスを正式な UUID へ付け替える
+ * @param idToUuid ids.json の ids（CVE/GHSA → 正式 uuid）
+ */
+export function migrateStatuses(idToUuid: Record<string, string>): number {
+  const map = loadStatuses();
+  let moved = 0;
+  for (const [uuid, rec] of Object.entries(map)) {
+    if (!rec.ids?.length) continue;
+    const real = rec.ids.map((id) => idToUuid[id]).find((u) => u && ID_PATTERNS.uuid.test(u) && u !== uuid);
+    if (!real) continue;
+    const existing = map[real];
+    if (!existing || existing.updatedAt < rec.updatedAt) map[real] = { status: rec.status, updatedAt: rec.updatedAt };
+    delete map[uuid];
+    moved++;
+  }
+  if (moved) write(KEY.status, map);
+  return moved;
+}
+
+// ---------------- settings ----------------
+
+export function validateSettings(raw: unknown): Settings {
+  const r = isObj(raw) ? raw : {};
+  return { os: strList(r.os, 20, 40), languages: strList(r.languages, 30, 40), products: strList(r.products, 50, 60) };
+}
+export const loadSettings = () => validateSettings(read(KEY.settings));
+export const saveSettings = (s: Settings) => write(KEY.settings, validateSettings(s));
+
+// ---------------- deps ----------------
+
+export function validateDeps(raw: unknown): DepsStore {
+  const r = isObj(raw) ? raw : {};
+  const files = Array.isArray(r.files)
+    ? r.files
+        .filter(isObj)
+        .map((f) => ({ name: String(f.name ?? "").slice(0, 200), count: Number(f.count) || 0, loadedAt: isIso(f.loadedAt) ? f.loadedAt : "" }))
+        .slice(0, 50)
+    : [];
+  const deps: Dependency[] = Array.isArray(r.deps)
+    ? r.deps
+        .filter(isObj)
+        .filter((d) => typeof d.name === "string" && typeof d.version === "string" && typeof d.ecosystem === "string")
+        .map((d) => ({
+          ecosystem: String(d.ecosystem).slice(0, 30),
+          name: String(d.name).slice(0, 214),
+          version: String(d.version).slice(0, 64),
+          approximate: Boolean(d.approximate),
+          dev: Boolean(d.dev),
+          manifest: String(d.manifest ?? "").slice(0, 200),
+        }))
+        .slice(0, 20000)
+    : [];
+  return { files, deps };
+}
+export const loadDeps = () => validateDeps(read(KEY.deps));
+export const saveDeps = (d: DepsStore) => {
+  write(KEY.deps, validateDeps(d));
+  try {
+    backend()?.removeItem(KEY.osvCache); // 依存が変わったら OSV の結果を捨てる
+  } catch {}
+};
+
+// ---------------- depHits ----------------
+
+export function loadDepHits(): Record<string, string> {
+  const raw = read(KEY.depHits);
+  const out: Record<string, string> = {};
+  if (isObj(raw)) for (const [k, v] of Object.entries(raw)) if (ID_PATTERNS.uuid.test(k) && isIso(v)) out[k] = v;
+  return out;
+}
+export function recordDepHits(uuids: string[]) {
+  const hits = loadDepHits();
+  let changed = false;
+  for (const u of uuids) {
+    if (!hits[u] && ID_PATTERNS.uuid.test(u)) {
+      hits[u] = new Date().toISOString();
+      changed = true;
+    }
+  }
+  if (changed) write(KEY.depHits, hits);
+}
+
+// ---------------- OSV cache ----------------
+
+export function loadOsvCache<T>(key: string, maxAgeMs = 86_400_000): T[] | undefined {
+  const raw = read(KEY.osvCache);
+  if (!isObj(raw) || raw.key !== key || !isIso(raw.at) || Date.now() - Date.parse(raw.at) > maxAgeMs) return undefined;
+  return Array.isArray(raw.items) ? (raw.items as T[]) : undefined;
+}
+export const saveOsvCache = (key: string, items: unknown[]) => write(KEY.osvCache, { at: new Date().toISOString(), key, items });
+
+// ---------------- export / import ----------------
+
+export function exportAll(): string {
+  return JSON.stringify(
+    { app: "vulnkb", version: 1, exportedAt: new Date().toISOString(), status: loadStatuses(), settings: loadSettings(), deps: loadDeps(), depHits: loadDepHits() },
+    null,
+    2,
+  );
+}
+
+export function importAll(json: string): { statuses: number } {
+  const raw = JSON.parse(json);
+  if (!isObj(raw) || raw.app !== "vulnkb") throw new Error("Vuln KB のエクスポートファイルではありません");
+  const status = validateStatusMap(raw.status);
+  write(KEY.status, { ...loadStatuses(), ...status });
+  if (raw.settings) saveSettings(validateSettings(raw.settings));
+  if (raw.deps) saveDeps(validateDeps(raw.deps));
+  if (isObj(raw.depHits)) {
+    const hits = loadDepHits();
+    for (const [k, v] of Object.entries(raw.depHits)) if (ID_PATTERNS.uuid.test(k) && isIso(v)) hits[k] = v;
+    write(KEY.depHits, hits);
+  }
+  return { statuses: Object.keys(status).length };
+}
+
+// ---------------- past snapshots ----------------
+// 「過去の未対応」に一度出たものを保存しておき、依存から外れても対応完了にするまで表示し続ける
+
+const SNAP_KEY = "vulnkb:v1:pastSnapshots";
+
+export function loadSnapshots<T extends { uuid: string }>(): Record<string, T> {
+  const raw = read(SNAP_KEY);
+  const out: Record<string, T> = {};
+  if (isObj(raw)) for (const [k, v] of Object.entries(raw)) if (ID_PATTERNS.uuid.test(k) && isObj(v) && v.uuid === k) out[k] = v as unknown as T;
+  return out;
+}
+
+export function saveSnapshots<T extends { uuid: string }>(items: T[]) {
+  const map = { ...loadSnapshots<T>() };
+  for (const it of items) map[it.uuid] = it;
+  const statuses = loadStatuses();
+  // 対応完了になったものは消す。上限 500 件
+  const kept = Object.entries(map).filter(([k]) => statuses[k]?.status !== "done").slice(-500);
+  write(SNAP_KEY, Object.fromEntries(kept));
+}
diff --git a/site/src/lib/vulns.ts b/site/src/lib/vulns.ts
new file mode 100644
index 0000000..1a7ca10
--- /dev/null
+++ b/site/src/lib/vulns.ts
@@ -0,0 +1,64 @@
+/**
+ * サイト（ビルド時）: データ読み込みと表示用の定義
+ */
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import type { Severity, Vulnerability, WeekIndex } from "../../../src/types/vuln.js";
+import { WEEK_RE, isoWeekOf, weeksBetween } from "../../../src/shared/week.js";
+
+function readJson<T>(rel: string, fallback: T): T {
+  try {
+    return JSON.parse(readFileSync(resolve(process.cwd(), "../data", rel), "utf-8")) as T;
+  } catch {
+    return fallback;
+  }
+}
+
+export const loadWeekIndex = () => readJson<WeekIndex>("weeks/index.json", { updatedAt: new Date().toISOString(), weeks: [] });
+
+export function loadWeek(week: string): Vulnerability[] {
+  if (!WEEK_RE.test(week)) return [];
+  return readJson<Vulnerability[]>(`weeks/${week}.json`, []);
+}
+
+/** ページを作る週: データの最初の週〜ビルド時点の週（データのない週も空ページを作る） */
+export function allWeeks(): string[] {
+  const idx = loadWeekIndex();
+  const current = isoWeekOf(new Date());
+  const first = idx.weeks[0]?.week ?? current;
+  return weeksBetween(first < current ? first : current, current);
+}
+
+export const SEVERITIES: Severity[] = ["critical", "high", "medium", "low", "unknown"];
+
+export const SEV_STYLE: Record<Severity, { label: string; ja: string; badge: string; dot: string }> = {
+  critical: { label: "Critical", ja: "緊急", badge: "bg-red-600 text-white", dot: "bg-red-600" },
+  high: { label: "High", ja: "重要", badge: "bg-orange-500 text-white", dot: "bg-orange-500" },
+  medium: { label: "Medium", ja: "警告", badge: "bg-amber-400 text-amber-950", dot: "bg-amber-400" },
+  low: { label: "Low", ja: "注意", badge: "bg-emerald-600 text-white", dot: "bg-emerald-600" },
+  unknown: { label: "未評価", ja: "未評価", badge: "bg-gray-300 text-gray-800", dot: "bg-gray-400" },
+};
+
+export const OS_OPTIONS = ["Windows", "macOS", "Linux", "iOS", "Android", "ChromeOS", "FreeBSD", "Network/Firmware"];
+
+export const LANGUAGE_OPTIONS = [
+  "JavaScript/TypeScript",
+  "Python",
+  "Go",
+  "Java/Kotlin",
+  "C#/.NET",
+  "PHP",
+  "Ruby",
+  "Rust",
+  "Swift",
+  "Dart",
+  "Elixir/Erlang",
+  "GitHub Actions",
+];
+
+export const fmtDate = (iso: string) =>
+  new Date(iso).toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo", month: "2-digit", day: "2-digit" });
+
+/** <script type="application/json"> に埋め込む JSON（</script> での脱出を防ぐ） */
+export const safeJson = (data: unknown) =>
+  JSON.stringify(data).replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026").replace(/\u2028/g, "\\u2028").replace(/\u2029/g, "\\u2029");
