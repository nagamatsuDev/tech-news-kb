---
/**
 * 旧タスクページ → 今週のページの「過去の未対応」タブへ移動
 * （タスクはブラウザ内の照合に置き換えた。このファイルは削除してよい）
 */
import { allWeeks } from "../lib/vulns";

const weeks = allWeeks();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/weeks/${weeks[weeks.length - 1]}#past`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Vuln KB</title>
  </head>
  <body><p><a href={target}>過去の未対応へ</a></p></body>
</html>
