---
import type { Severity } from "../../../src/types/vuln.js";
import { SEV_STYLE } from "../lib/vulns";

interface Props {
  severity: Severity;
  score?: number;
}
const { severity, score } = Astro.props;
const s = SEV_STYLE[severity];
---

<span class={`inline-flex shrink-0 items-center gap-1 rounded px-1.5 py-0.5 text-xs font-semibold tabular-nums ${s.badge}`}>
  {s.label}{score !== undefined && <span class="font-normal opacity-90">{score.toFixed(1)}</span>}
</span>
