---
/**
 * 対応タスク 1 件
 */
import type { VulnTask } from "../../../src/types/vuln.js";
import SeverityBadge from "./SeverityBadge.astro";
import { fmtDate } from "../lib/vulns";

interface Props {
  task: VulnTask;
  showProject?: boolean;
}
const { task: t, showProject = false } = Astro.props;
const resolved = t.status === "resolved";
---

<li class={`flex gap-3 rounded-lg border bg-white p-3 ${resolved ? "border-gray-100 opacity-60" : "border-gray-200"}`}>
  <span
    class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded border text-xs ${
      resolved ? "border-emerald-500 bg-emerald-500 text-white" : "border-gray-300"
    }`}
    aria-label={resolved ? "解決済み" : "未対応"}
  >
    {resolved ? "✓" : ""}
  </span>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-1.5">
      <SeverityBadge severity={t.severity} score={t.cvssScore} />
      {t.kev && <span class="rounded bg-red-100 px-1.5 py-0.5 text-xs font-semibold text-red-700">🔥 悪用確認</span>}
      {t.kind === "watch" && <span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs text-sky-800">要確認</span>}
      {t.dev && <span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600">dev</span>}
      {showProject && <span class="rounded bg-indigo-50 px-1.5 py-0.5 text-xs font-medium text-indigo-700">{t.project}</span>}
      <a href={t.url} target="_blank" rel="noopener" class="font-mono text-xs text-gray-500 hover:text-brand-600 hover:underline">
        {t.vulnId}
      </a>
    </div>
    <p class={`mt-1 text-sm font-medium ${resolved ? "line-through" : "text-gray-900"}`}>{t.action}</p>
    <p class="mt-0.5 truncate text-xs text-gray-500" title={t.title}>{t.title}</p>
    <p class="mt-1 text-xs text-gray-400">
      {t.installedVersions.length > 0 && <>使用中 <span class="font-mono">{t.package}@{t.installedVersions.join(", ")}</span> · </>}
      {t.manifests.length > 0 && <>{t.manifests.join(", ")} · </>}
      {resolved && t.resolvedAt ? `解決 ${fmtDate(t.resolvedAt)}` : `検出 ${fmtDate(t.firstSeenAt)}`}
    </p>
  </div>
</li>
