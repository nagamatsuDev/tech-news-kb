---
/**
 * 記事カードコンポーネント
 * index.json の ArticleIndexEntry 1件を受け取って表示する
 */
interface Props {
  id: string;
  title: string;
  url: string;
  source: string;
  category?: string;
  summary: string;
  tags: string[];
  publishedAt: string;
}

const { title, url, source, category, summary, tags, publishedAt } = Astro.props;
const base = import.meta.env.BASE_URL;

// ソースごとのバッジスタイル
const sourceBadge: Record<string, { label: string; class: string }> = {
  rss:              { label: category ? `RSS · ${category}` : "RSS", class: "bg-blue-50 text-blue-700 border-blue-200" },
  hackernews:       { label: "Hacker News",    class: "bg-orange-50 text-orange-700 border-orange-200" },
  "github-trending":{ label: "GitHub Trending", class: "bg-purple-50 text-purple-700 border-purple-200" },
};
const badge = sourceBadge[source] ?? { label: source, class: "bg-gray-100 text-gray-600 border-gray-200" };

// 日付を "YYYY-MM-DD" に整形
const dateStr = publishedAt.split("T")[0];
---

<article
  class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-brand-300 hover:shadow-md"
  data-pagefind-body
>
  <!-- ソースバッジ + 日付 -->
  <div class="mb-2 flex items-center gap-2">
    <span class={`rounded-full border px-2 py-0.5 text-xs font-medium ${badge.class}`}>
      {badge.label}
    </span>
    <time class="text-xs text-gray-400" datetime={publishedAt}>{dateStr}</time>
  </div>

  <!-- タイトル -->
  <h2 class="mb-1 text-base font-semibold leading-snug">
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-gray-900 hover:text-brand-600 group-hover:underline"
    >
      {title}
      <span class="ml-1 text-xs text-gray-400">↗</span>
    </a>
  </h2>

  <!-- 概要 -->
  {summary && (
    <p class="mb-3 line-clamp-2 text-sm text-gray-500">{summary}</p>
  )}

  <!-- タグ一覧 -->
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1">
      {tags.map((tag) => (
        <a
          href={`${base}/tags/${tag}`}
          class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600 hover:bg-brand-50 hover:text-brand-700"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>
