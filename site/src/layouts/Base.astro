---
/**
 * ベースレイアウト
 * 全ページ共通のヘッダー・フッター・Pagefind 検索 UI を含む
 */
interface Props {
  title?: string;
  description?: string;
}

const { title = "Tech News KB", description = "技術ニュース知識ベース" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Pagefind の CSS（ビルド後に生成される） -->
    <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />

    <!-- Inter フォント -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="h-full bg-gray-50 text-gray-900 antialiased">
    <!-- ヘッダー -->
    <header class="sticky top-0 z-10 border-b border-gray-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href={base} class="flex items-center gap-2 font-semibold text-gray-900 hover:text-brand-600">
          <span class="text-xl">📡</span>
          <span>Tech News KB</span>
        </a>

        <!-- 検索ボタン（モバイル） -->
        <button
          id="search-toggle"
          class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5 text-sm text-gray-500 hover:bg-gray-100 md:hidden"
        >
          🔍 検索
        </button>

        <!-- デスクトップ ナビ -->
        <nav class="hidden items-center gap-6 text-sm md:flex">
          <a href={base} class="text-gray-600 hover:text-gray-900">ホーム</a>
          <a href={`${base}/tags`} class="text-gray-600 hover:text-gray-900">タグ一覧</a>
          <a
            href="https://github.com/nagamatsuDev"
            target="_blank"
            rel="noopener"
            class="text-gray-600 hover:text-gray-900"
          >GitHub</a>
        </nav>
      </div>

      <!-- 検索バー（常時表示 on デスクトップ / toggle on mobile） -->
      <div id="search-bar" class="hidden border-t border-gray-100 bg-white px-4 py-2 md:block">
        <div id="pagefind-ui" class="mx-auto max-w-5xl"></div>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <!-- フッター -->
    <footer class="mt-16 border-t border-gray-200 bg-white py-8">
      <div class="mx-auto max-w-5xl px-4 text-center text-sm text-gray-400">
        <p>Tech News KB — RSS / Hacker News / GitHub Trending を毎朝自動収集</p>
        <p class="mt-1">
          Powered by
          <a href="https://astro.build" class="underline hover:text-gray-600">Astro</a>
          +
          <a href="https://pagefind.app" class="underline hover:text-gray-600">Pagefind</a>
        </p>
      </div>
    </footer>

    <!-- Pagefind の初期化（ビルド後に生成される JS を読み込む） -->
    <script>
      // Pagefind UI は astro build 後に /pagefind/pagefind-ui.js として生成される
      // dev モードでは存在しないため、エラーを握りつぶす
      async function initPagefind() {
        try {
          // @ts-ignore
          const { PagefindUI } = await import("/tech-news-kb/pagefind/pagefind-ui.js");
          new PagefindUI({
            element: "#pagefind-ui",
            showSubResults: true,
            translations: {
              placeholder: "記事を検索...",
              zero_results: "該当する記事が見つかりませんでした",
            },
          });
        } catch {
          // dev モードでは Pagefind が存在しないため無視
        }
      }
      initPagefind();

      // モバイル検索トグル
      const toggle = document.getElementById("search-toggle");
      const bar = document.getElementById("search-bar");
      toggle?.addEventListener("click", () => {
        bar?.classList.toggle("hidden");
      });
    </script>
  </body>
</html>
