---
/**
 * ベースレイアウト
 *  - 右上の設定ボタン → 設定ダイアログ（OS・言語・製品・依存ファイル・エクスポート）
 *  - Content-Security-Policy: スクリプトは自サイトのみ、通信は自サイトと OSV.dev のみ
 */
import { LANGUAGE_OPTIONS, OS_OPTIONS } from "../lib/vulns";

interface Props {
  title?: string;
  description?: string;
}
const { title = "Vuln KB", description = "脆弱性を週ごとにまとめるナレッジベース" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const csp = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data:",
  "connect-src 'self' https://api.osv.dev",
  "object-src 'none'",
  "base-uri 'none'",
  "form-action 'none'",
].join("; ");
---

<!doctype html>
<html lang="ja" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-full bg-gray-50 text-gray-900 antialiased" data-base={base}>
    <header class="sticky top-0 z-10 border-b border-gray-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-2.5">
        <a href={`${base}/`} class="flex shrink-0 items-center gap-2 font-semibold text-gray-900 hover:text-brand-600">
          <span class="text-xl">🛡️</span><span>Vuln KB</span>
        </a>
        <div class="flex flex-1 justify-center"><slot name="header" /></div>
        <button
          id="settings-open"
          type="button"
          class="flex shrink-0 items-center gap-1 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50"
          aria-haspopup="dialog"
        >
          ⚙️ <span class="hidden sm:inline">設定</span>
        </button>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-6">
      <slot />
    </main>

    <footer class="mt-16 border-t border-gray-200 bg-white py-6 text-center text-xs text-gray-400">
      Vuln KB — NVD / GitHub Advisory / CISA KEV / JVN iPedia から毎朝収集。設定とステータスはこのブラウザ内だけに保存されます。
    </footer>

    <!-- 設定ダイアログ -->
    <dialog id="settings" class="w-full max-w-2xl rounded-xl p-0 shadow-xl backdrop:bg-black/40">
      <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
        <h2 class="text-lg font-semibold">設定</h2>
        <button type="button" id="settings-close" class="rounded px-2 py-1 text-gray-500 hover:bg-gray-100" aria-label="閉じる">✕</button>
      </div>
      <div class="max-h-[75vh] space-y-6 overflow-y-auto px-5 py-4 text-sm">
        <p class="rounded-lg bg-gray-50 p-3 text-xs text-gray-600">
          ここでの設定・依存ファイル・ステータスは、このブラウザの localStorage だけに保存されます。別の端末に移すときはエクスポートを使ってください。
        </p>

        <fieldset>
          <legend class="mb-2 font-medium">使っている OS</legend>
          <div class="flex flex-wrap gap-2">
            {OS_OPTIONS.map((o) => (
              <label class="flex items-center gap-1 rounded-full border border-gray-200 px-3 py-1">
                <input type="checkbox" name="os" value={o} class="rounded border-gray-300" /> {o}
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-2 font-medium">使っている言語</legend>
          <div class="flex flex-wrap gap-2">
            {LANGUAGE_OPTIONS.map((l) => (
              <label class="flex items-center gap-1 rounded-full border border-gray-200 px-3 py-1">
                <input type="checkbox" name="lang" value={l} class="rounded border-gray-300" /> {l}
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="products" class="mb-1 block font-medium">製品・ミドルウェア（1 行に 1 つ）</label>
          <textarea id="products" rows="3" class="w-full rounded-lg border border-gray-200 px-3 py-2" placeholder={"nginx\npostgresql\nnode.js"}></textarea>
        </div>

        <div>
          <p class="mb-1 font-medium">依存ファイル</p>
          <p class="mb-2 text-xs text-gray-500">
            package.json / package-lock.json / pnpm-lock.yaml / yarn.lock / requirements.txt / poetry.lock / go.mod / Cargo.lock / Gemfile.lock / composer.lock。
            ファイルはブラウザ内で解析し、パッケージ名とバージョンだけを保存します。「過去の未対応」の照合では、それを OSV.dev に送ります。
          </p>
          <input id="deps-file" type="file" multiple class="block w-full text-xs" />
          <p id="deps-summary" class="mt-2 text-xs text-gray-600"></p>
          <p id="deps-error" class="mt-1 hidden text-xs text-red-600"></p>
          <button type="button" id="deps-clear" class="mt-2 text-xs text-red-600 hover:underline">依存ファイルをすべて削除</button>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t border-gray-100 pt-4">
          <button type="button" id="export" class="rounded-lg border border-gray-200 px-3 py-1.5 hover:bg-gray-50">エクスポート</button>
          <label class="cursor-pointer rounded-lg border border-gray-200 px-3 py-1.5 hover:bg-gray-50">
            インポート<input id="import" type="file" accept="application/json,.json" class="hidden" />
          </label>
          <span id="io-message" class="text-xs text-gray-500"></span>
        </div>
      </div>
      <div class="flex justify-end gap-2 border-t border-gray-200 px-5 py-3">
        <button type="button" id="settings-cancel" class="rounded-lg px-3 py-1.5 text-gray-600 hover:bg-gray-100">キャンセル</button>
        <button type="button" id="settings-save" class="rounded-lg bg-brand-600 px-4 py-1.5 font-medium text-white hover:bg-brand-700">保存</button>
      </div>
    </dialog>

    <script>
      import "../lib/client/settings-ui";
      import "../lib/client/copy";
    </script>
  </body>
</html>
